---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import { home } from '../i18n/home';
import '../styles/global.css';
const c = home.id;
---
<Base
  title="Beranda"
  description={c.hero.subtitle}
>
  <Nav />

  <Hero
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    image="/img/BentanagnAlamNagariSalido.jpeg"
    imageAlt="Bentangan alam Nagari Salido, foto udara dari drone"
  />

  <!-- Intro -->
  <section class="intro">
    <div class="intro-inner">
      <div class="intro-text reveal">
        <h2>{c.intro.heading}</h2>
        <p>{c.intro.p1}</p>
        <p>{c.intro.p2}</p>
        <a href={c.intro.ctaHref} class="text-link">{c.intro.cta}</a>
      </div>
      <figure class="intro-figure reveal">
        <img
          src="/img/BentanganAlamKampungTambang.jpeg"
          alt={c.intro.imgAlt}
          loading="lazy"
        />
        <figcaption>{c.intro.imgCaption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Teaser -->
  <section class="teaser-section">
    <div class="teaser-inner reveal">
      <blockquote class="teaser-quote">
        "{c.teaser.quote}"
        <cite>{c.teaser.cite}</cite>
      </blockquote>
      <p class="teaser-body">{c.teaser.body}</p>
      <a href={c.teaser.ctaHref} class="text-link">{c.teaser.cta}</a>
    </div>
  </section>

  <!-- Atlas -->
  <section class="atlas-section">
    <div class="atlas-inner reveal">
      <h2>{c.atlas.heading}</h2>
      <p>{c.atlas.body}</p>
      <a href={c.atlas.ctaHref} class="text-link-inv">{c.atlas.cta}</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-brand">Salido</span>
      <span class="footer-copy">Riset historis Nagari Salido, Pesisir Minangkabau</span>
      <nav class="footer-nav">
        <a href="/sejarah">Sejarah</a>
        <a href="/jurnal">Jurnal</a>
        <a href="/arsip">Arsip</a>
        <a href="/atlas">Atlas</a>
        <a href="/tentang">Tentang</a>
      </nav>
    </div>
  </footer>
</Base>

<style>
/* ── Intro ─────────────────────────────────────────────────────────── */
.intro { padding: 7rem 2.5rem; }
.intro-inner {
  max-width: var(--max-wide);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
.intro-text h2 {
  font-size: clamp(1.6rem, 2.5vw, 2.1rem);
  font-weight: 400;
  margin-bottom: 1.25rem;
}
.intro-text p {
  color: var(--color-muted);
  line-height: 1.8;
  margin-bottom: 1rem;
  font-size: 1rem;
}
.intro-figure img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  display: block;
}
.intro-figure figcaption {
  font-size: 0.8rem;
  font-style: italic;
  color: var(--color-muted);
  margin-top: 0.5rem;
}

/* ── Teaser ─────────────────────────────────────────────────────────── */
.teaser-section {
  background: var(--color-text);
  padding: 7rem 2.5rem;
}
.teaser-inner {
  max-width: 560px;
  margin: 0 auto;
}
.teaser-quote {
  border-left: 2px solid var(--color-accent);
  padding-left: 1.5rem;
  margin: 0 0 2rem;
  font-style: italic;
  font-size: clamp(1rem, 1.3vw, 1.15rem);
  color: rgba(255,255,255,0.80);
  line-height: 1.75;
  font-family: var(--font-body);
}
.teaser-quote cite {
  display: block;
  font-style: normal;
  font-family: var(--font-ui);
  font-size: 0.78rem;
  color: rgba(255,255,255,0.30);
  margin-top: 0.75rem;
}
.teaser-body {
  font-family: var(--font-body);
  font-size: 1rem;
  color: rgba(255,255,255,0.50);
  line-height: 1.8;
  margin-bottom: 2rem;
}

/* ── Atlas ──────────────────────────────────────────────────────────── */
.atlas-section {
  background: var(--color-text);
  padding: 7rem 2.5rem;
}
.atlas-inner {
  max-width: 560px;
  margin: 0 auto;
}
.atlas-section h2 {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  font-weight: 400;
  color: white;
  margin-bottom: 1.25rem;
}
.atlas-section p {
  color: rgba(255,255,255,0.55);
  line-height: 1.8;
  margin-bottom: 2rem;
}

/* ── Links ──────────────────────────────────────────────────────────── */
.text-link {
  font-family: var(--font-body);
  font-style: italic;
  font-size: 1rem;
  color: var(--color-accent);
  text-decoration: none;
  border-bottom: 1px solid rgba(139,105,20,0.3);
  padding-bottom: 1px;
  display: inline-block;
  margin-top: 0.75rem;
  transition: border-color 250ms;
}
.text-link:hover { border-color: var(--color-accent); }
/* .text-link on dark (teaser) background */
.teaser-inner .text-link {
  color: rgba(255,255,255,0.60);
  border-bottom-color: rgba(255,255,255,0.15);
}
.teaser-inner .text-link:hover {
  color: white;
  border-bottom-color: rgba(255,255,255,0.4);
}

.text-link-inv {
  font-family: var(--font-body);
  font-style: italic;
  font-size: 1rem;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.15);
  padding-bottom: 1px;
  display: inline-block;
  transition: color 250ms, border-color 250ms;
}
.text-link-inv:hover { color: white; border-color: rgba(255,255,255,0.4); }

/* ── Footer ─────────────────────────────────────────────────────────── */
.footer { background: var(--color-surface); padding: 2.5rem; }
.footer-inner {
  max-width: var(--max-wide);
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
}
.footer-brand {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-style: italic;
}
.footer-copy {
  font-size: 0.8rem;
  color: var(--color-muted);
  flex: 1;
}
.footer-nav { display: flex; gap: 1.5rem; }
.footer-nav a {
  font-size: 0.85rem;
  color: var(--color-muted);
  text-decoration: none;
}
.footer-nav a:hover { color: var(--color-text); }

@media (max-width: 768px) {
  .intro-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .intro, .teaser-section, .atlas-section { padding: 5rem 1.5rem; }
}
</style>
