---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ArsipCard from '../components/ArsipCard.astro';
import '../styles/global.css';
---
<Base
  title="Arsip"
  description="Sumber primer dari Nationaal Archief Den Haag dan Rijksmuseum Amsterdam yang mendokumentasikan tambang emas Salido."
>
  <Nav />

  <main class="arsip-page">

    <header class="arsip-header reveal">
      <h1 class="arsip-heading">Sumber Primer</h1>
      <p class="arsip-subtitle"><em>Dokumen dari Nationaal Archief, Den Haag &amp; Rijksmuseum Amsterdam</em></p>
    </header>

    <section class="arsip-list">
      <ArsipCard
        image="/img/NL-HaNA_1.04.02_7964_0015-groot.jpg"
        imageAlt="Halaman manuskrip laporan VOC tentang operasi penambangan di Sillida, 1681"
        title="Laporan Awal Penambangan Salido, 1681"
        source="Nationaal Archief, Den Haag — NL-HaNA 1.04.02"
        year="1681"
        excerpt="Dokumen pertama yang mencatat operasi penambangan VOC di Sillida: perjanjian dengan penghulu lokal, pos pertahanan Pulau Cingkuak, dan laporan produksi emas pertama yang jauh di bawah ekspektasi."
        href="/arsip/laporan-tambang-1681"
      />
      <ArsipCard
        image="/img/RP-P-1896-A-19368-994.jpg"
        imageAlt="Ukiran Elias Hesse 1687 — Nette Afbeelding der Sillidaatsche Goud Myn, menggambarkan operasi tambang emas Salido dengan pekerja, shaft, dan bangunan VOC"
        title="Nette Afbeelding der Sillidaatsche Goud Myn — Elias Hesse, 1687"
        source="Rijksmuseum Amsterdam — RP-P-1896-A-19368-994"
        year="1687"
        excerpt="Ukiran terperinci operasi tambang emas Salido: pekerja dan budak di latar depan, struktur shaft yang membelah lereng gunung, bangunan administrasi VOC di atas."
        href="/arsip/ukiran-hesse-1687"
      />
    </section>

    <footer class="arsip-footer">
      <nav class="footer-nav" aria-label="Navigasi utama">
        <a href="/sejarah">Sejarah</a>
        <a href="/jurnal">Jurnal</a>
        <a href="/arsip">Arsip</a>
        <a href="/atlas">Atlas</a>
        <a href="/tentang">Tentang</a>
      </nav>
    </footer>

  </main>
</Base>

<style>
.arsip-page {
  max-width: var(--max-wide);
  margin: 0 auto;
  padding: 8rem 2.5rem 6rem;
}

/* Header */
.arsip-header {
  margin-bottom: 3.5rem;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  padding-bottom: 2rem;
}
.arsip-heading {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 400;
  line-height: 1.15;
  margin-bottom: 0.6rem;
}
.arsip-subtitle {
  font-size: 1rem;
  color: var(--color-muted);
  font-family: var(--font-body);
}

/* Card list */
.arsip-list {
  display: flex;
  flex-direction: column;
}

/* Footer */
.arsip-footer {
  margin-top: 5rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}
.footer-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 2rem;
}
.footer-nav a {
  font-family: var(--font-ui);
  font-size: 0.85rem;
  color: var(--color-muted);
  text-decoration: none;
  transition: color 250ms;
}
.footer-nav a:hover { color: var(--color-text); }

@media (max-width: 640px) {
  .arsip-page { padding: 6rem 1.25rem 4rem; }
  .footer-nav { gap: 0.5rem 1.25rem; }
}
</style>
