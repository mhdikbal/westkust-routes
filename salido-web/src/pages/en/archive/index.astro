---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import '../../../styles/global.css';
---
<Base
  title="Archive"
  description="Primary sources from Nationaal Archief Den Haag and Rijksmuseum Amsterdam documenting the Salido gold mines."
>
  <Nav lang="en" />

  <main class="archive-page">

    <header class="archive-header">
      <h1 class="archive-title">Primary Sources</h1>
      <p class="archive-subtitle">
        <em>Documents from Nationaal Archief, Den Haag &amp; Rijksmuseum Amsterdam</em>
      </p>
    </header>

    <section class="archive-list">

      <!-- Card 1 — Initial Mining Report 1681 -->
      <article class="archive-card reveal">
        <a href="/en/archive/mining-report-1681" class="card-img-wrap">
          <img
            src="/img/NL-HaNA_1.04.02_7964_0015-groot.jpg"
            alt="Initial Mining Report, Salido 1681 — Nationaal Archief Den Haag"
            loading="lazy"
            class="card-img"
          />
        </a>
        <div class="card-body">
          <div class="card-meta">
            <span class="card-source">Nationaal Archief, Den Haag — NL-HaNA 1.04.02</span>
            <span class="card-year">1681</span>
          </div>
          <h2 class="card-title">
            <a href="/en/archive/mining-report-1681">Initial Mining Report, Salido 1681</a>
          </h2>
          <p class="card-excerpt">
            The first document recording VOC mining operations at Sillida: agreements with local
            penghulu, the Pulau Cingkuak defensive post, and the first gold production report —
            far below expectations.
          </p>
          <a href="/en/archive/mining-report-1681" class="card-link">Read document &rarr;</a>
        </div>
      </article>

      <!-- Card 2 — Elias Hesse Engraving 1687 -->
      <article class="archive-card reveal">
        <a href="/en/archive/engraving-1687" class="card-img-wrap">
          <img
            src="/img/RP-P-1896-A-19368-994.jpg"
            alt="Nette Afbeelding der Sillidaatsche Goud Myn — Elias Hesse, 1687, Rijksmuseum Amsterdam"
            loading="lazy"
            class="card-img"
          />
        </a>
        <div class="card-body">
          <div class="card-meta">
            <span class="card-source">Rijksmuseum Amsterdam — RP-P-1896-A-19368-994</span>
            <span class="card-year">1687</span>
          </div>
          <h2 class="card-title">
            <a href="/en/archive/engraving-1687">Nette Afbeelding der Sillidaatsche Goud Myn — Elias Hesse, 1687</a>
          </h2>
          <p class="card-excerpt">
            Detailed engraving of the Salido gold mine operations: workers and enslaved laborers
            in the foreground, shaft structure cutting through the mountain, VOC administrative
            buildings above.
          </p>
          <a href="/en/archive/engraving-1687" class="card-link">View engraving &rarr;</a>
        </div>
      </article>

    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-brand">Salido</span>
      <span class="footer-copy">Historical research — Nagari Salido, Minangkabau Coast</span>
      <nav class="footer-nav">
        <a href="/en">Home</a>
        <a href="/en/history">History</a>
        <a href="/en/journal">Journal</a>
        <a href="/atlas">Atlas</a>
        <a href="/en/about">About</a>
      </nav>
    </div>
  </footer>
</Base>

<style>
/* ── Page wrapper ───────────────────────────────────────────────────── */
.archive-page {
  padding-top: 6rem; /* clear fixed nav */
}

/* ── Header ─────────────────────────────────────────────────────────── */
.archive-header {
  max-width: var(--max-wide);
  margin: 0 auto;
  padding: 5rem 2.5rem 3rem;
  border-bottom: 1px solid rgba(90, 78, 60, 0.15);
}
.archive-title {
  font-family: var(--font-heading);
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  font-weight: 400;
  letter-spacing: 0.01em;
  margin-bottom: 0.75rem;
}
.archive-subtitle {
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--color-muted);
  line-height: 1.6;
}

/* ── Archive list ────────────────────────────────────────────────────── */
.archive-list {
  max-width: var(--max-wide);
  margin: 0 auto;
  padding: 4rem 2.5rem 7rem;
  display: flex;
  flex-direction: column;
  gap: 3.5rem;
}

/* ── Card ────────────────────────────────────────────────────────────── */
.archive-card {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 2.25rem;
  align-items: start;
  padding-bottom: 3.5rem;
  border-bottom: 1px solid rgba(90, 78, 60, 0.12);
}
.archive-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

/* Image */
.card-img-wrap {
  display: block;
  flex-shrink: 0;
  overflow: hidden;
}
.card-img {
  width: 200px;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  display: block;
  filter: sepia(0.45) contrast(0.92) brightness(0.97);
  transition: filter 350ms ease;
}
.card-img-wrap:hover .card-img {
  filter: sepia(0.15) contrast(0.98) brightness(1.0);
}

/* Body */
.card-body {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding-top: 0.15rem;
}

.card-meta {
  display: flex;
  align-items: baseline;
  gap: 1.25rem;
  flex-wrap: wrap;
}
.card-source {
  font-family: var(--font-ui);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.055em;
  text-transform: uppercase;
  color: var(--color-accent);
}
.card-year {
  font-family: var(--font-ui);
  font-size: 0.72rem;
  color: var(--color-muted);
  letter-spacing: 0.04em;
}

.card-title {
  font-family: var(--font-heading);
  font-size: clamp(1.25rem, 2vw, 1.55rem);
  font-weight: 400;
  line-height: 1.3;
  margin-top: 0.25rem;
}
.card-title a {
  color: var(--color-text);
  text-decoration: none;
  transition: color 200ms ease;
}
.card-title a:hover {
  color: var(--color-accent);
  opacity: 1;
}

.card-excerpt {
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--color-muted);
  line-height: 1.8;
  max-width: 60ch;
  margin-top: 0.25rem;
}

.card-link {
  display: inline-block;
  margin-top: 0.75rem;
  font-family: var(--font-body);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--color-accent);
  text-decoration: none;
  border-bottom: 1px solid rgba(122, 92, 16, 0.3);
  padding-bottom: 1px;
  transition: border-color 200ms ease;
}
.card-link:hover {
  opacity: 1;
  border-color: var(--color-accent);
}

/* ── Footer ─────────────────────────────────────────────────────────── */
.footer {
  background: var(--color-surface);
  padding: 2.5rem;
}
.footer-inner {
  max-width: var(--max-wide);
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
}
.footer-brand {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-style: italic;
}
.footer-copy {
  font-size: 0.8rem;
  color: var(--color-muted);
  flex: 1;
}
.footer-nav {
  display: flex;
  gap: 1.5rem;
}
.footer-nav a {
  font-size: 0.85rem;
  color: var(--color-muted);
  text-decoration: none;
}
.footer-nav a:hover {
  color: var(--color-text);
  opacity: 1;
}

/* ── Responsive ──────────────────────────────────────────────────────── */
@media (max-width: 640px) {
  .archive-header { padding: 4rem 1.5rem 2.5rem; }
  .archive-list   { padding: 3rem 1.5rem 5rem; gap: 2.5rem; }

  .archive-card {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
}
</style>
