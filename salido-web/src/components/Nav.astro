---
interface Props {
  lang?: 'id' | 'en';
}
const { lang = 'id' } = Astro.props;

const linksID = [
  { href: '/',         label: 'Beranda' },
  { href: '/sejarah',  label: 'Sejarah' },
  { href: '/jurnal',   label: 'Jurnal' },
  { href: '/arsip',    label: 'Arsip' },
  { href: '/atlas',    label: 'Atlas' },
  { href: '/tentang',  label: 'Tentang' },
];

const linksEN = [
  { href: '/en',         label: 'Home' },
  { href: '/en/history', label: 'History' },
  { href: '/en/journal', label: 'Journal' },
  { href: '/en/archive', label: 'Archive' },
  { href: '/atlas',      label: 'Atlas' },
  { href: '/en/about',   label: 'About' },
];

const links = lang === 'en' ? linksEN : linksID;
const current = Astro.url.pathname;
const altHref  = lang === 'id' ? '/en' : '/';
const altLabel = lang === 'id' ? 'EN' : 'ID';
---
<nav class="nav" id="nav">
  <a href={lang === 'en' ? '/en' : '/'} class="nav-brand">Salido</a>
  <ul class="nav-links">
    {links.map(l => (
      <li>
        <a href={l.href} class:list={['nav-link', { active: current === l.href || current === l.href + '/' }]}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
  <a href={altHref} class="lang-switch">{altLabel}</a>
</nav>

<style>
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 2.5rem;
  transition: background 300ms ease, padding 300ms ease, box-shadow 300ms ease;
}
.nav.scrolled {
  background: var(--color-bg);
  padding: 1rem 2.5rem;
  box-shadow: 0 1px 0 rgba(0,0,0,0.06);
}
.nav-brand {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 400;
  font-style: italic;
  color: white;
  text-decoration: none;
  transition: color 300ms ease;
}
.nav.scrolled .nav-brand { color: var(--color-text); }
.nav-links {
  list-style: none;
  display: flex;
  gap: 2rem;
}
.nav-link {
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: rgba(255,255,255,0.75);
  text-decoration: none;
  transition: color 250ms ease;
}
.nav.scrolled .nav-link { color: var(--color-muted); }
.nav-link:hover { color: white; }
.nav.scrolled .nav-link:hover { color: var(--color-text); }
.nav-link.active { color: white; border-bottom: 1px solid rgba(255,255,255,0.4); padding-bottom: 1px; }
.nav.scrolled .nav-link.active { color: var(--color-text); border-color: rgba(0,0,0,0.25); }

/* Language switch — plain link, no button */
.lang-switch {
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: rgba(255,255,255,0.50);
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.20);
  border-radius: 2px;
  padding: 0.2rem 0.6rem;
  transition: color 250ms, border-color 250ms;
  flex-shrink: 0;
}
.lang-switch:hover { color: white; border-color: rgba(255,255,255,0.55); }
.nav.scrolled .lang-switch { color: var(--color-muted); border-color: rgba(0,0,0,0.18); }
.nav.scrolled .lang-switch:hover { color: var(--color-text); border-color: rgba(0,0,0,0.45); }

@media (max-width: 640px) {
  .nav { padding: 1rem 1.25rem; }
  .nav-links { gap: 1rem; }
  .nav-link { font-size: 0.8rem; }
}
</style>

<script>
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => {
  nav?.classList.toggle('scrolled', window.scrollY > 60);
}, { passive: true });
</script>
