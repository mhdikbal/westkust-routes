---
interface Props {
  image: string;
  imageAlt: string;
  title: string;
  source: string;
  year: string;
  excerpt: string;
  href: string;
}
const { image, imageAlt, title, source, year, excerpt, href } = Astro.props;
---
<article class="arsip-card reveal">
  <a href={href} class="arsip-img-link">
    <img src={image} alt={imageAlt} class="arsip-img" loading="lazy" />
  </a>
  <div class="arsip-body">
    <p class="arsip-meta">{source}, {year}</p>
    <h3 class="arsip-title"><a href={href}>{title}</a></h3>
    <p class="arsip-excerpt">{excerpt}</p>
    <a href={href} class="arsip-read">Baca selengkapnya</a>
  </div>
</article>

<style>
.arsip-card {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 2.5rem;
  align-items: start;
  padding: 2rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.arsip-img-link { display: block; overflow: hidden; }
.arsip-img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  filter: sepia(15%) contrast(1.05);
  transition: transform 400ms ease;
  display: block;
}
.arsip-img-link:hover .arsip-img { transform: scale(1.02); }

.arsip-meta {
  font-size: 0.8rem;
  font-style: italic;
  color: var(--color-muted);
  margin-bottom: 0.5rem;
}
.arsip-title {
  font-size: 1.15rem;
  font-weight: 400;
  margin-bottom: 0.75rem;
}
.arsip-title a {
  color: var(--color-text);
  text-decoration: none;
}
.arsip-title a:hover { color: var(--color-accent); }
.arsip-excerpt {
  font-size: 0.925rem;
  color: var(--color-muted);
  line-height: 1.7;
  margin-bottom: 1rem;
}
.arsip-read {
  font-size: 0.9rem;
  font-style: italic;
  color: var(--color-muted);
  text-decoration: none;
  border-bottom: 1px solid rgba(0,0,0,0.15);
  padding-bottom: 1px;
  transition: color 250ms, border-color 250ms;
}
.arsip-read:hover { color: var(--color-text); border-color: var(--color-text); }

@media (max-width: 640px) {
  .arsip-card { grid-template-columns: 1fr; }
  .arsip-img { aspect-ratio: 16/9; }
}
</style>
