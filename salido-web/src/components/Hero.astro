---
interface Props {
  title: string;
  subtitle?: string;
  image: string;
  imageAlt: string;
}
const { title, subtitle, image, imageAlt } = Astro.props;
---
<section class="hero" aria-label="Hero">
  <div class="hero-bg">
    <img src={image} alt={imageAlt} class="hero-img" loading="eager" fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    <slot name="cta">
      <a href="/sejarah" class="hero-lanjut">Mulai membaca &darr;</a>
    </slot>
  </div>
</section>

<style>
.hero {
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 600px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.hero-bg { position: absolute; inset: 0; }
.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(28,25,23,0.75) 0%,
    rgba(28,25,23,0.20) 55%,
    rgba(28,25,23,0.05) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 2;
  max-width: var(--max-wide);
  width: 100%;
  margin: 0 auto;
  padding: 0 2.5rem 5rem;
}
.hero-title {
  font-family: var(--font-heading);
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  font-weight: 400;
  color: white;
  max-width: 16ch;
  line-height: 1.05;
  margin-bottom: 1.5rem;
  letter-spacing: 0.01em;
}
.hero-subtitle {
  font-family: var(--font-body);
  font-size: clamp(1rem, 1.4vw, 1.15rem);
  color: rgba(255,255,255,0.70);
  max-width: 48ch;
  line-height: 1.7;
  margin-bottom: 2.5rem;
}
.hero-lanjut {
  font-family: var(--font-body);
  font-size: 1rem;
  font-style: italic;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.25);
  padding-bottom: 2px;
  transition: color 250ms ease, border-color 250ms ease;
}
.hero-lanjut:hover {
  color: white;
  border-color: rgba(255,255,255,0.6);
}
@media (max-width: 640px) {
  .hero-content { padding: 0 1.5rem 3.5rem; }
}
</style>
