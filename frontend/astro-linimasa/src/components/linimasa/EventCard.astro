---
import type { LinimasaEvent, EventType } from '../../lib/types';
import { EVENT_TYPE_LABELS, EVENT_TYPE_ICONS } from '../../lib/types';

interface Props {
  event: LinimasaEvent;
  isTreaty?: boolean;
}

const { event: ev, isTreaty = false } = Astro.props;
const typeLabel = EVENT_TYPE_LABELS[ev.event_type];
const iconPath = EVENT_TYPE_ICONS[ev.event_type];
const meta = [
  ev.event_date_raw || '—',
  ev.ruler_actor || '—',
  `vol. ${ev.source_document}, hlm. ${ev.source_page}${ev.book_page ? ` (${ev.book_page})` : ''}`,
].join(' · ');
---

{isTreaty ? (
  <details class="treaty-highlight" data-id={ev.id} data-type={ev.event_type} open>
    <img class="bg" src="/img/treaty-panel.jpg" alt="Ilustrasi perkamen tua bertepi terbakar dengan sketsa benteng pesisir">
    <div class="scrim"></div>
    <div class="treaty-highlight-content">
      <p class="treaty-highlight-tag">Klimaks narasi &middot; {typeLabel}</p>
      <p class="treaty-highlight-year mono">{ev.year ?? '—'}</p>
      <h3 class="treaty-highlight-title">{ev.title}</h3>
      <p class="treaty-highlight-meta">{meta}</p>
      <div class="treaty-highlight-quote">&ldquo;{ev.text_asli}&rdquo;</div>
      {ev.notes && <div class="notes text-sm mt-2">{ev.notes}</div>}
      <span class="unconf">confidence_flag: {ev.confidence_flag}</span>
    </div>
  </details>
) : (
  <details class="card" data-id={ev.id} data-type={ev.event_type}>
    <summary>
      <div class="card-head">
        <span class="card-year mono">{ev.year ?? '—'}</span>
        <span class="card-title">{ev.title}</span>
        <span class={`evt-badge evt-${ev.event_type}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={iconPath}/>
          </svg>
          {typeLabel}
        </span>
      </div>
      <p class="card-meta">{meta}</p>
    </summary>
    <div class="card-detail">
      <div class="quote">&ldquo;{ev.text_asli}&rdquo;</div>
      {ev.notes && <div class="notes">{ev.notes}</div>}
      <span class="unconf">confidence_flag: {ev.confidence_flag}</span>
    </div>
  </details>
)}
