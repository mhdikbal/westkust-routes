---
---
<section class="relative min-h-dvh w-full overflow-hidden flex flex-col">
  <img
    class="absolute inset-0 w-full h-full object-cover object-[center_42%]"
    src="/img/linimasa-hero.jpg"
    alt="Ilustrasi kapal-kapal dagang VOC berlayar mendekati benteng pesisir bertingkat, dengan peta pelayaran tua dan kompas sebagai lapisan langit"
  />
  <div class="absolute inset-0"
    style="background: linear-gradient(0deg, rgba(0,0,0,1) 0%, rgba(0,0,0,.95) 8%, rgba(0,0,0,.6) 25%, rgba(0,0,0,.15) 50%, rgba(0,0,0,0) 70%), linear-gradient(135deg, rgba(0,0,0,.5) 0%, transparent 60%)"
  ></div>

  <nav class="relative z-10 flex items-center justify-between px-5 md:px-10 py-4">
    <div class="flex items-center gap-5">
      <a class="flex items-center gap-1.5 text-ink/80 hover:text-ink text-sm transition-colors" href="../">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 19l-7-7 7-7"/><path d="M3 12h18"/></svg>
        Peta VOC
      </a>
      <a class="text-ink/60 hover:text-ink text-sm transition-colors hidden md:inline" href="../riset/tema/">Sankey tema</a>
      <a class="text-ink/60 hover:text-ink text-sm transition-colors hidden md:inline" href="../riset/jaringan/">Jaringan pelabuhan</a>
      <a class="text-ink/60 hover:text-ink text-sm transition-colors hidden md:inline" href="../riset/atjeh-dagang/">Dagang Atjeh</a>
    </div>
    <span class="text-ink/50 text-sm font-serif italic">Salido</span>
  </nav>

  <div class="relative z-10 flex-1 flex flex-col justify-end px-5 md:px-10 pb-16 md:pb-24 max-w-3xl">
    <p class="text-xs tracking-widest uppercase text-muted-dark mb-3">Kronik Pantai Barat &middot; 1600–1775</p>
    <h1 class="font-serif text-3xl md:text-5xl lg:text-6xl font-bold text-ink leading-tight mb-4">
      Dari Kontrak Pertama ke <em class="not-italic text-voc-copper">Mundurnya VOC dari Barus</em>
    </h1>
    <p class="text-sm md:text-base text-muted-dark leading-relaxed mb-6 max-w-xl">
      Seratus satu peristiwa suksesi &amp; politik kekuasaan Atjeh atas pantai
      barat Sumatra &mdash; dari kontrak lada pertama VOC-Atjeh sampai VOC sendiri menutup logenya
      di Barus, kalah bersaing dagang dengan Inggris.
    </p>
    <div class="flex items-center gap-3 mb-8">
      <a class="inline-flex items-center gap-2 bg-ink text-paper px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-ink/90 transition-colors" href="#content">
        Mulai Menelusuri
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="inline-flex items-center gap-2 border border-line text-ink/80 px-5 py-2.5 rounded-lg text-sm hover:bg-panel transition-colors" href="../">
        Lihat Peta
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg>
      </a>
    </div>
    <a class="inline-flex items-center gap-2 text-xs text-muted hover:text-ink transition-colors" href="#content">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      Gulir untuk memulai penelusuran
    </a>
  </div>
</section>
