# Materi riset thesis (PDF besar, draft, notebook Colab) — bukan bagian app,
# jangan masuk git (bisa ratusan MB). Selective tracking: 8 artefak metodologis
# episode-ontology dipilih visible eksplisit di bawah (lihat
# CORPUS_DIPLOMATICUM_RECOVERY_PREFLIGHT.md, fase apply-patch) — SEMUA isi lain
# docs/thesis/ (CSV korpus, PDF, notebook, XML, model output, dsb.) tetap ignored.
docs/thesis/*
!docs/thesis/EPISODE_ONTOLOGY_ANNOTATION_PROTOCOL_DRAFT.md

# Model 3B-CD simulation/recovery framework (Fase 1, audited) — only the
# .py source and test modules are tracked. Everything else under
# docs/thesis/colab/ (CSV corpora, other model3_*.py scripts, notebooks,
# and any simulation output/cache the framework generates at runtime —
# __pycache__, .pytest_cache, JSONL failure logs, result CSVs, etc.)
# stays ignored.
!docs/thesis/colab/
docs/thesis/colab/*
!docs/thesis/colab/model3b_cd_simulator/
docs/thesis/colab/model3b_cd_simulator/*
!docs/thesis/colab/model3b_cd_simulator/*.py
!docs/thesis/colab/model3b_cd_simulator/tests/
docs/thesis/colab/model3b_cd_simulator/tests/*
!docs/thesis/colab/model3b_cd_simulator/tests/*.py

# Model 3B recovery-tournament harness (M0/M2/M3, implementation-only turn,
# not yet run at real scale) — same policy as model3b_cd_simulator above:
# only .py source/smoke-test modules tracked, __pycache__ ignored.
!docs/thesis/colab/model3b_tournament_harness/
docs/thesis/colab/model3b_tournament_harness/*
!docs/thesis/colab/model3b_tournament_harness/*.py

# Model 3B V2 Wave 1 specification-validation infrastructure (parser, schema
# validator, applicability validator, immutable M3-blocker registry, and
