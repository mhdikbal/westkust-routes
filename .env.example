# ============================================================
# .env.example — Template konfigurasi Westkust Routes
# Salin file ini ke .env dan isi dengan nilai nyata.
# JANGAN commit file .env ke git.
# ============================================================

# Database (PostgreSQL / PostGIS)
POSTGRES_DB=vocdb
POSTGRES_USER=vocuser
POSTGRES_PASSWORD=changeme_strong_password_here

# FastAPI Backend — connection strings
# Nilai dibangun otomatis dari variabel di atas, tapi bisa di-override.
DATABASE_URL=postgresql+asyncpg://vocuser:changeme_strong_password_here@db:5432/vocdb
DATABASE_SYNC_URL=postgresql://vocuser:changeme_strong_password_here@db:5432/vocdb
SYNC_DATABASE_URL=postgresql://vocuser:changeme_strong_password_here@db:5432/vocdb

# Django Frontend
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme_generate_with_python_secrets_module

# App config
DEBUG=False
API_BASE_URL=http://backend:8000

# CORS — comma-separated list origin yang diizinkan akses API
ALLOWED_ORIGINS=http://localhost:8084,http://localhost:8001

# SALIDO-HDT Enclave (enclave-1682) — read-only canonical dataset & solver snapshot
# Container paths (set via docker-compose.yml volume mounts):
SALIDO_HDT_DATA_DIR=/app/data/salido_hdt_model_v0_4_1
SALIDO_HDT_SCENARIO_DIR=/app/data/salido_solver_snapshot
SALIDO_HDT_CACHE_DIR=/tmp/salido-hdt-cache
